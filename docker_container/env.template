# Vector Database API - environment template
# Copy this to .env and fill in ONE of the two options below.
# Both options can set QDRANT_API_KEY; the LLM provider keys only apply to
# the "default-*" providers (see llm_provider.py) since normal requests pass
# their own api_key in the request body.

# ---------------------------------------------------------------------------
# Option A: Direct API keys (default, simplest - works out of the box)
# ---------------------------------------------------------------------------
QDRANT_API_KEY=change-me-to-a-strong-key
# OPENAI_API_KEY=
# MISTRAL_API_KEY=
# AZURE_OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Option B: Infisical-managed secrets (recommended for shared/production
# servers). Leave Option A's provider keys unset above and fill these in
# instead -- secrets_loader.py will fetch QDRANT_API_KEY, OPENAI_API_KEY,
# MISTRAL_API_KEY, AZURE_OPENAI_API_KEY, etc. from Infisical at startup and
# populate them into the environment automatically.
#
# All four required vars below must be set together, or none at all.
# ---------------------------------------------------------------------------
# INFISICAL_PROJECT_ID=
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_ENVIRONMENT=
# # must match the Infisical environment slug for this server.

# Optional, only needed when not using the default Infisical Cloud region
# (defaults to https://app.infisical.com when unset). For EU-region
# projects (e.g. GDPR-sensitive deployments), set this explicitly:
# INFISICAL_SITE_URL=https://eu.infisical.com
